{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "dev": "tsx server.ts",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "supabase:schema": "tsx scripts/apply-supabase-schema.ts",
    "supabase:seed": "tsx scripts/seed-supabase.ts",
    "clean": "rm -rf dist server.js",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/functions": "3.11.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fast-xml-parser": "5.12.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "5.0.9",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "10.5.0",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "signature_pad": "5.1.4",
    "vite": "^6.2.3",
    "web-push": "4.0.0"
  },
  "overrides": {
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
